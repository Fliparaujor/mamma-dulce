# Lista das variáveis e segredos usados pelo Worker (sem valores reais).
# Para desenvolvimento local o Wrangler lê .dev.vars; copie .dev.vars.example para lá.

# Gere com: npm run hash-password
ADMIN_PASSWORD_HASH=

# Opcional no desenvolvimento. Gere em https://publish.buffer.com/settings/api
BUFFER_API_KEY=

# Opcional: credenciais S3 do R2 para upload direto do navegador ao bucket.
# Sem elas, o upload passa pelo Worker (funciona igual, só limitado a 100 MB por requisição).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Variáveis públicas (ficam em wrangler.jsonc → vars, não são segredos):
# APP_TIMEZONE=America/Belem
# R2_BUCKET_NAME=historias-publisher-media
# MAX_UPLOAD_BYTES=524288000
# PUBLIC_BASE_URL=https://historias-publisher.SEU-SUBDOMINIO.workers.dev
